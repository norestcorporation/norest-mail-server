                    "type": "string"
                  },
                  "attachments": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Message sent"
          },
          "202": {
            "description": "Delivery status unknown"
          },
          "400": {
            "description": "Invalid request or missing idempotency key"
