  "item": [
    {
      "name": "01. Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["v1", "auth", "register"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.access_token) {",
                  "        pm.environment.set('access_token', jsonData.access_token);",
                  "    }",
                  "    if (jsonData.user && jsonData.user.id) {",
                  "        pm.environment.set('account_id', jsonData.user.id);",
                  "    }",
                  "    if (jsonData.user && jsonData.user.email) {",
                  "        pm.environment.set('email', jsonData.user.email);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["v1", "auth", "login"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.access_token) {",
                  "        pm.environment.set('access_token', jsonData.access_token);",
                  "    }",
                  "    if (jsonData.user && jsonData.user.id) {",
                  "        pm.environment.set('account_id', jsonData.user.id);",
                  "    }",
                  "    if (jsonData.user && jsonData.user.email) {",
                  "        pm.environment.set('email', jsonData.user.email);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/me",
              "host": ["{{base_url}}"],
              "path": ["v1", "me"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.id) {",
                  "        pm.environment.set('account_id', jsonData.id);",
                  "    }",
                  "    if (jsonData.email) {",
                  "        pm.environment.set('email', jsonData.email);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02. Platform Domain",
      "item": [
        {
          "name": "List Available Domains",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/domains/platform",
              "host": ["{{base_url}}"],
              "path": ["v1", "domains", "platform"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (Array.isArray(jsonData) && jsonData.length > 0) {",
                  "        pm.environment.set('domain_id', jsonData[0].id);",
                  "        pm.environment.set('domain_name', jsonData[0].name);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Domain",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/domains/{{domain_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "domains", "{{domain_id}}"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.id) {",
                  "        pm.environment.set('domain_id', jsonData.id);",
                  "    }",
                  "    if (jsonData.name) {",
                  "        pm.environment.set('domain_name', jsonData.name);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Check Domain Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/domains/check/{{domain_name}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "domains", "check", "{{domain_name}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "03. Email Address",
      "item": [
        {
          "name": "Check Username Availability",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/domains/{{domain_id}}/addresses/check/{{username}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "domains", "{{domain_id}}", "addresses", "check", "{{username}}"]
            }
          },
          "response": []
        },
        {
          "name": "Reserve Email Address",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"local_part\": \"{{username}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/domains/{{domain_id}}/addresses/reserve",
              "host": ["{{base_url}}"],
              "path": ["v1", "domains", "{{domain_id}}", "addresses", "reserve"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.id) {",
                  "        pm.environment.set('reservation_id', jsonData.id);",
                  "    }",
                  "    if (jsonData.email) {",
                  "        pm.environment.set('email_address', jsonData.email);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Reservation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/domains/{{domain_id}}/addresses",
              "host": ["{{base_url}}"],
              "path": ["v1", "domains", "{{domain_id}}", "addresses"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (Array.isArray(jsonData) && jsonData.length > 0) {",
                  "        pm.environment.set('reservation_id', jsonData[0].id);",
                  "        if (jsonData[0].email) {",
                  "            pm.environment.set('email_address', jsonData[0].email);",
                  "        }",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Claim Address",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/addresses/{{reservation_id}}/claim",
              "host": ["{{base_url}}"],
              "path": ["v1", "addresses", "{{reservation_id}}", "claim"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "04. Mail Account Provisioning",
      "item": [
        {
          "name": "Create Mail Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/mail/session",
              "host": ["{{base_url}}"],
              "path": ["v1", "mail", "session"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.account_id) {",
                  "        pm.environment.set('mail_account_id', jsonData.account_id);",
                  "    }",
                  "    if (jsonData.session_token) {",
                  "        pm.environment.set('session_token', jsonData.session_token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Account",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/mail/account",
              "host": ["{{base_url}}"],
              "path": ["v1", "mail", "account"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.id) {",
                  "        pm.environment.set('mailbox_id', jsonData.id);",
                  "    }",
                  "    if (jsonData.stalwart_account_id) {",
                  "        pm.environment.set('mail_account_id', jsonData.stalwart_account_id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Provisioning Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/mail/provisioning-status",
              "host": ["{{base_url}}"],
              "path": ["v1", "mail", "provisioning-status"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.status) {",
                  "        pm.environment.set('provisioning_status', jsonData.status);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05. Mailbox",
      "item": [
        {
          "name": "List Mailboxes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/mail/mailboxes",
              "host": ["{{base_url}}"],
              "path": ["v1", "mail", "mailboxes"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.data && Array.isArray(jsonData.data)) {",
                  "        jsonData.data.forEach(mailbox => {",
                  "            if (mailbox.role === 'inbox') {",
                  "                pm.environment.set('inbox_id', mailbox.id);",
                  "            } else if (mailbox.role === 'sent') {",
                  "                pm.environment.set('sent_id', mailbox.id);",
                  "            } else if (mailbox.role === 'drafts') {",
                  "                pm.environment.set('drafts_id', mailbox.id);",
                  "            } else if (mailbox.role === 'trash') {",
                  "                pm.environment.set('trash_id', mailbox.id);",
                  "            } else if (mailbox.role === 'spam') {",
                  "                pm.environment.set('spam_id', mailbox.id);",
                  "            }",
                  "        });",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Mailbox",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/mail/mailboxes/{{mailbox_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "mail", "mailboxes", "{{mailbox_id}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "06. Messages",
      "item": [
        {
          "name": "List Messages",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/mail/messages?mailbox_id={{inbox_id}}&limit=20",
              "host": ["{{base_url}}"],
              "path": ["v1", "mail", "messages"],
              "query": [
                {
                  "key": "mailbox_id",
                  "value": "{{inbox_id}}"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.data && Array.isArray(jsonData.data) && jsonData.data.length > 0) {",
                  "        pm.environment.set('message_id', jsonData.data[0].id);",
                  "        if (jsonData.data[0].thread_id) {",
                  "            pm.environment.set('thread_id', jsonData.data[0].thread_id);",
                  "        }",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Message",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/mail/messages/{{message_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "mail", "messages", "{{message_id}}"]
            }
          },
          "response": []
        },
        {
          "name": "Search Messages",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/mail/search?query=search_term",
              "host": ["{{base_url}}"],
              "path": ["v1", "mail", "search"],
              "query": [
                {
                  "key": "query",
                  "value": "search_term"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Incremental Sync",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/mail/sync",
              "host": ["{{base_url}}"],
              "path": ["v1", "mail", "sync"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.sync_state) {",
                  "        pm.environment.set('sync_state', jsonData.sync_state);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "07. Attachments",
      "item": [
        {
          "name": "Upload Attachment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/octet-stream"
              }
            ],
            "body": {
              "mode": "file",
              "file": {}
            },
            "url": {
              "raw": "{{base_url}}/v1/mail/attachments",
              "host": ["{{base_url}}"],
              "path": ["v1", "mail", "attachments"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
