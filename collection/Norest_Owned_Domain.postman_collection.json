                  "    if (jsonData.blob_id) {",
                  "        pm.environment.set('attachment_id', jsonData.blob_id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Download Attachment",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/mail/attachments/{{attachment_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "mail", "attachments", "{{attachment_id}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "08. Drafts",
      "item": [
        {
          "name": "Create Draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from\": \"{{email_address}}\",\n  \"to\": [\"recipient@example.com\"],\n  \"subject\": \"Draft Subject\",\n  \"text_body\": \"Draft content\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/mail/drafts",
              "host": ["{{base_url}}"],
              "path": ["v1", "mail", "drafts"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.id) {",
                  "        pm.environment.set('draft_id', jsonData.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Draft",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/mail/drafts/{{draft_id}}",
              "host": ["{{base_url}}"],
              "path": ["v1", "mail", "drafts", "{{draft_id}}"]
            }
          },
          "response": []
