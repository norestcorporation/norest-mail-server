    {
      "name": "08 JMAP - Mailboxes",
      "item": [
        {
          "name": "Get Mailboxes",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "basic",
              "basic": {
                "username": "{{email_address}}",
                "password": "{{mail_access_token}}"
              }
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"using\": [\n    \"urn:ietf:params:jmap:core\",\n    \"urn:ietf:params:jmap:mail\"\n  ],\n  \"methodCalls\": [\n    [\n      \"Mailbox/get\",\n      {\n        \"accountId\": \"{{account_id}}\"\n      },\n      \"0\"\n    ]\n  ]\n}"
            },
            "url": {
              "raw": "{{jmap_base}}",
              "host": ["{{jmap_base}}"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    var mailboxes = jsonData.methodResponses[0][1].list;",
                  "    for (var i = 0; i < mailboxes.length; i++) {",
                  "        if (mailboxes[i].role === 'inbox') {",
                  "            pm.environment.set(\"inbox_id\", mailboxes[i].id);",
                  "            console.log(\"Inbox ID: \" + mailboxes[i].id);",
                  "        }",
                  "        if (mailboxes[i].role === 'drafts') {",
                  "            pm.environment.set(\"drafts_id\", mailboxes[i].id);",
                  "            console.log(\"Drafts ID: \" + mailboxes[i].id);",
                  "        }",
                  "        if (mailboxes[i].role === 'trash') {",
                  "            pm.environment.set(\"trash_id\", mailboxes[i].id);",
                  "            console.log(\"Trash ID: \" + mailboxes[i].id);",
                  "        }",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "09 JMAP - Emails",
      "item": [
        {
          "name": "Query Emails",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "basic",
              "basic": {
                "username": "{{email_address}}",
                "password": "{{mail_access_token}}"
              }
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"using\": [\n    \"urn:ietf:params:jmap:core\",\n    \"urn:ietf:params:jmap:mail\"\n  ],\n  \"methodCalls\": [\n    [\n      \"Email/query\",\n      {\n        \"accountId\": \"{{account_id}}\",\n        \"filter\": {\n          \"inMailbox\": \"{{inbox_id}}\"\n        },\n        \"limit\": 10\n      },\n      \"0\"\n    ]\n  ]\n}"
            },
            "url": {
              "raw": "{{jmap_base}}",
              "host": ["{{jmap_base}}"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    var emailIds = jsonData.methodResponses[0][1].ids;",
                  "    if (emailIds && emailIds.length > 0) {",
                  "        pm.environment.set(\"email_id\", emailIds[0]);",
                  "        console.log(\"Email ID saved: \" + emailIds[0]);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "basic",
              "basic": {
                "username": "{{email_address}}",
                "password": "{{mail_access_token}}"
              }
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"using\": [\n    \"urn:ietf:params:jmap:core\",\n    \"urn:ietf:params:jmap:mail\"\n  ],\n  \"methodCalls\": [\n    [\n      \"Email/get\",\n      {\n        \"accountId\": \"{{account_id}}\",\n        \"ids\": [\"{{email_id}}\"],\n        \"properties\": [\"id\", \"from\", \"to\", \"subject\", \"receivedAt\", \"preview\", \"keywords\", \"bodyValues\"]\n      },\n      \"0\"\n    ]\n  ]\n}"
            },
            "url": {
              "raw": "{{jmap_base}}",
              "host": ["{{jmap_base}}"]
            }
          },
          "response": []
        },
        {
          "name": "Mark as Read",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "basic",
              "basic": {
                "username": "{{email_address}}",
                "password": "{{mail_access_token}}"
              }
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"using\": [\n    \"urn:ietf:params:jmap:core\",\n    \"urn:ietf:params:jmap:mail\"\n  ],\n  \"methodCalls\": [\n    [\n      \"Email/set\",\n      {\n        \"accountId\": \"{{account_id}}\",\n        \"update\": {\n          \"{{email_id}}\": {\n            \"keywords/$seen\": true\n          }\n        }\n      },\n      \"0\"\n    ]\n  ]\n}"
            },
            "url": {
              "raw": "{{jmap_base}}",
              "host": ["{{jmap_base}}"]
            }
          },
          "response": []
        },
        {
          "name": "Star Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "basic",
              "basic": {
                "username": "{{email_address}}",
