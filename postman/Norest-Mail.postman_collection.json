              }
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"using\": [\n    \"urn:ietf:params:jmap:core\",\n    \"urn:ietf:params:jmap:mail\"\n  ],\n  \"methodCalls\": [\n    [\n      \"Email/set\",\n      {\n        \"accountId\": \"{{account_id}}\",\n        \"update\": {\n          \"{{email_id}}\": {\n            \"keywords/$flagged\": true\n          }\n        }\n      },\n      \"0\"\n    ]\n  ]\n}"
            },
            "url": {
              "raw": "{{jmap_base}}",
              "host": ["{{jmap_base}}"]
            }
          },
          "response": []
        },
        {
          "name": "Move to Trash",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "basic",
              "basic": {
                "username": "{{email_address}}",
                "password": "{{mail_access_token}}"
              }
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"using\": [\n    \"urn:ietf:params:jmap:core\",\n    \"urn:ietf:params:jmap:mail\"\n  ],\n  \"methodCalls\": [\n    [\n      \"Email/set\",\n      {\n        \"accountId\": \"{{account_id}}\",\n        \"update\": {\n          \"{{email_id}}\": {\n            \"mailboxIds\": {\n              \"{{trash_id}}\": true,\n              \"{{inbox_id}}\": false\n            }\n          }\n        }\n      },\n      \"0\"\n    ]\n  ]\n}"
            },
            "url": {
              "raw": "{{jmap_base}}",
              "host": ["{{jmap_base}}"]
            }
          },
          "response": []
        }
      ]
    },
